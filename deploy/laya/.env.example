# Laya 决策服务配置示例 —— 复制为 .env 后修改；不要把真实密钥提交进仓库。
# 变量名与 laya/serve.py（提交 6d942c9）核对一致。

# 绑定地址/端口。0.0.0.0 表示监听所有网卡（服务端监听，不是客户端目标）。
LAYA_HOST=0.0.0.0
LAYA_PORT=8000

# 服务端 Bearer 校验密钥；公共/共享网络部署必须设置。
# 生成示例：openssl rand -hex 32
LAYA_API_KEY=change-me

# torch 设备偏好：cpu / cuda / mps；拿不到会静默回退 CPU。
# LAYA_DEVICE=cpu

# 启动即预加载 checkpoint（1）或惰性加载（0）。
LAYA_PRELOAD=1

# 只预加载指定 checkpoint（逗号分隔）；留空=全部。
# LAYA_MODELS=typed-decisions

# CPU 推理线程上限；建议 <= 物理核数。
# LAYA_THREADS=4

# 常驻 checkpoint 上限。
LAYA_MAX_LOADED=2

# 并发与单请求 token 预算上限（服务端硬上限）。
LAYA_MAX_CONCURRENT=16
LAYA_MAX_TOKEN_BUDGET=8192

# 反向代理后的公共前缀（套 TLS 时用）。
# LAYA_ROOT_PATH=/laya

LAYA_LOG_LEVEL=info
